# PRAVIN Environment Variables
# Copy this file to .env and fill in your own values.

# Kimi K3 API Key (Moonshot AI OpenAI-compatible API)
KIMI_API_KEY=123

# Google OAuth Client ID
GOOGLE_CLIENT_ID=123

# Google OAuth Client Secret (optional for some flows)
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Other configuration
APP_NAME=PRAVIN

